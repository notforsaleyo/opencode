# Track only the Windows-native configuration and authored content.
/*
!/.gitignore
!/README.md
!/AGENTS.md
!/cli.json
!/opencode.jsonc
!/dcp.jsonc
!/shared/
!/skills/
!/backlog/
!/handoff/
!/custom-plugins/
!/commands/
!/agents/
!/themes/

# MCP definitions are machine-local and are never part of the settings backup.
mcp/
mcp.json
mcp.jsonc
.mcp.json
.mcp.jsonc

# Temporary handoffs contain only these two authored/exported JSON files.
/handoff/*
!/handoff/*/
/handoff/*/*
!/handoff/*/metadata.json
!/handoff/*/session.json

# Dependencies, build output, caches and local machine state, at any depth.
node_modules/
dist/
build/
.cache/
cache/
logs/
tmp/
*.log
*.tmp
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Credentials and local overrides.
.env
.env.*
auth.json
credentials.json
service.json
*.local.json
*.local.jsonc
*.pem
*.key

# Session transfer JSON is allowed only in /handoff/; no databases or snapshots.
sessions/
conversations/
transcripts/
snapshots/
storage/
*.db
*.db-*
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*
