# Track only explicitly selected, portable configuration and authored content.
/*
!/.gitignore
!/README.md
!/AGENTS.md
!/shared/
!/dcp.jsonc
!/skills/
!/backlog/
!/handoff/
!/custom-plugins/
!/commands/
!/agents/
!/themes/

# Temporary handoffs contain only these two authored/exported JSON files.
/handoff/*
!/handoff/*/
/handoff/*/*
!/handoff/*/metadata.json
!/handoff/*/session.json

# Machine-local Codex usage customization is not shared.
/custom-plugins/codex-usage-tui/

# Dependencies, build output, caches and local machine state, at any depth.
node_modules/
dist/
build/
.cache/
cache/
logs/
tmp/
*.log
*.tmp
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Credentials and local overrides.
.env
.env.*
auth.json
credentials.json
service.json
*.local.json
*.local.jsonc
*.pem
*.key

# Session transfer JSON is allowed only in /handoff/; no databases or snapshots.
sessions/
conversations/
transcripts/
snapshots/
storage/
*.db
*.db-*
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*
