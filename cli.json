{
  "$schema": "https://opencode.ai/v2/cli.json",
  "plugins": [
    "C:/Users/rkdtj/.config/opencode/custom-plugins/codex-usage-tui"
  ],
  "theme": {
    "mode": "light",
    "name": "github"
  },
  "session": {
    "sidebar": "auto",
    "thinking": "hide",
    "markdown": "rendered",
    "grouping": "auto",
    "verbosity": "low",
    "image_preview": false,
    "tps": true,
    "permissions": "prompt",
    "scrollbar": true
  },
  "tabs": {
    "mode": "on",
    "layout": "vertical",
    "indicators": "status",
    "scope": "cwd"
  },
  "attention": {
    "notifications": true,
    "sound": true
  },
  "terminal": {
    "title": true,
    "copy": "select"
  },
  "debug": {
    "devtools": false
  },
  "animations": true,
  "prompt": {
    "editor": true
  },
  "scroll": {
    "acceleration": true
  },
  "keybinds": {
    "session.list": "ctrl+s",
    "session.child.first": "ctrl+down",
    "session.new": "ctrl+t",
    "variant.cycle": "ctrl+\\",
    "session.first": "ctrl+g,alt+home",
    "session.last": "ctrl+alt+g",
    "input.line.home": "home",
    "input.select.all": "ctrl+a,super+a",
    "input.line.end": "end,ctrl+e",
    "input.buffer.home": "ctrl+home",
    "input.buffer.end": "ctrl+end",
    "input.submit": "ctrl+return",
    "input.newline": "return,shift+return,ctrl+j",
    "prompt.queue": "ctrl+shift+return"
  },
  "leader": {
    "timeout": 2000
  }
}
