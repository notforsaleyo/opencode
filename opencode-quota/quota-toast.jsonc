{
  // Disable popup quota notifications entirely.
  "enableToast": false,

  // Show only the provider of the model currently in use.
  "onlyCurrentModel": true,

  // Show TUI slash command reports (/quota, /tokens_*) in a popup dialog.
  "tuiCommandDisplay": "dialog",

  // Show the compact quota line below the session prompt.
  "tuiCompactStatus": { "enabled": true, "homeBottom": true, "sessionPrompt": true },
}
